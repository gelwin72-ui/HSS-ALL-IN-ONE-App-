          ".read": "auth != null",
          ".write": "auth != null"
        },
        "classes": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "schoolProfile": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
